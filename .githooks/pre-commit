#!/bin/bash

# =============================================================================
# 🚀 PRE-COMMIT HOOK - Ekspedisi Quran
# =============================================================================
# Hook ini akan dijalankan SEBELUM setiap commit
# Pastikan build dan test sudah dijalankan di lokal
# =============================================================================

echo ""
echo "╔══════════════════════════════════════════════════════════════════╗"
echo "║  🔍 PRE-COMMIT CHECKLIST - Ekspedisi Quran                      ║"
echo "╚══════════════════════════════════════════════════════════════════╝"
echo ""

# Warna untuk output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

FAILED=0

# -----------------------------------------------------------------------------
# CHECK 1: Build Assets
# -----------------------------------------------------------------------------
echo "📦 CHECK 1: Build Assets"
if [ ! -d "public/build" ] || [ ! -f "public/build/manifest.json" ]; then
    echo -e "${RED}  ❌ FAILED: Build assets tidak ditemukan!${NC}"
    echo ""
    echo "  ⚠️  JALANKAN: npm ci && npm run build"
    echo ""
    FAILED=1
else
    BUILD_TIME=$(stat -c %Y public/build/manifest.json 2>/dev/null || stat -f %m public/build/manifest.json)
    CURRENT_TIME=$(date +%s)
    AGE_MINUTES=$(( (CURRENT_TIME - BUILD_TIME) / 60 ))

    if [ $AGE_MINUTES -gt 60 ]; then
        echo -e "${YELLOW}  ⚠️  WARNING: Build sudah ${AGE_MINUTES} menit yang lalu${NC}"
        echo "     Pertimbangkan rebuild jika ada perubahan frontend"
    else
        echo -e "${GREEN}  ✅ PASSED: Build assets ditemukan ( ${AGE_MINUTES} menit yang lalu )${NC}"
    fi
fi
echo ""

# -----------------------------------------------------------------------------
# CHECK 2: Tests
# -----------------------------------------------------------------------------
echo "🧪 CHECK 2: Tests"
if [ ! -f ".tests-passed" ]; then
    echo -e "${YELLOW}  ⚠️  WARNING: Belum ada verifikasi test lokal${NC}"
    echo ""
    echo "     📋 Jangan lupa jalankan: php artisan test"
    echo ""
    echo -n "     Apakah sudah menjalankan test? (y/N): "
    read -r response < /dev/tty
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        echo ""
        echo "  ❌ Commit dibatalkan. Jalankan: php artisan test"
        exit 1
    fi
    touch .tests-passed
else
    TEST_TIME=$(stat -c %Y .tests-passed 2>/dev/null || stat -f %m .tests-passed)
    CURRENT_TIME=$(date +%s)
    AGE_HOURS=$(( (CURRENT_TIME - TEST_TIME) / 3600 ))

    if [ $AGE_HOURS -gt 24 ]; then
        echo -e "${YELLOW}  ⚠️  WARNING: Test sudah ${AGE_HOURS} jam yang lalu${NC}"
        rm .tests-passed
    else
        echo -e "${GREEN}  ✅ PASSED: Tests sudah dijalankan ( ${AGE_HOURS} jam yang lalu )${NC}"
    fi
fi
echo ""

# -----------------------------------------------------------------------------
# CHECK 3: Code Style (Laravel Pint)
# -----------------------------------------------------------------------------
echo "🎨 CHECK 3: Code Style"
if command -v ./vendor/bin/pint &> /dev/null; then
    CHANGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.php$' || true)

    if [ -n "$CHANGED_PHP_FILES" ]; then
        echo "  🔍 Menjalankan Laravel Pint pada file yang berubah..."
        ./vendor/bin/pint --dirty --quiet

        if [ $? -ne 0 ]; then
            echo -e "${YELLOW}  ⚠️  Code style issues ditemukan dan sudah di-fix${NC}"
            echo "     Silahkan stage ulang file yang diubah"
            exit 1
        fi
    fi
    echo -e "${GREEN}  ✅ PASSED: Code style OK${NC}"
else
    echo -e "${YELLOW}  ⚠️  SKIP: Laravel Pint tidak ditemukan${NC}"
fi
echo ""

# -----------------------------------------------------------------------------
# CHECK 4: Migration Safety
# -----------------------------------------------------------------------------
echo "🗄️  CHECK 4: Migration Safety"
CHANGED_MIGRATIONS=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'database/migrations' || true)

if [ -n "$CHANGED_MIGRATIONS" ]; then
    echo -e "${YELLOW}  ⚠️  WARNING: Perubahan pada migration file terdeteksi!${NC}"
    echo ""
    echo "$CHANGED_MIGRATIONS" | while read file; do
        echo "     - $file"
    done
    echo ""
    echo "     Pastikan:"
    echo "       ✓ Tidak mengubah migration yang sudah di-push"
    echo "       ✓ Migration baru di-test di lokal"
    echo "       ✓ Backup database sebelum deploy"
    echo ""
fi

# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo "════════════════════════════════════════════════════════════════════"
if [ $FAILED -eq 1 ]; then
    echo -e "${RED}❌ PRE-COMMIT FAILED${NC}"
    echo ""
    echo "📋 LANGKAH PERBAIKAN:"
    echo "   1. npm ci && npm run build"
    echo "   2. php artisan test"
    echo "   3. git add public/build"
    echo "   4. git commit"
    echo ""
    exit 1
else
    echo -e "${GREEN}✅ PRE-COMMIT PASSED${NC}"
    echo ""
    echo "🚀 Siap untuk commit!"
    echo ""
fi

exit 0
